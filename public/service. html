<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>More Services • DHE GENIUS MEDIA</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background:
        radial-gradient(circle at top right, #123c3c, transparent 35%),
        linear-gradient(160deg, #071111, #020606);
      color: #fff;
      min-height: 100vh;
      padding-bottom: 85px;
    }

    header {
      padding: 18px 16px;
      display: flex;
      align-items: center;
      gap: 12px;
      background: rgba(4,12,12,.94);
      border-bottom: 1px solid rgba(255,255,255,.08);
      position: sticky;
      top: 0;
      z-index: 20;
    }

    .back {
      width: 40px;
      height: 40px;
      display: grid;
      place-items: center;
      border-radius: 12px;
      background: rgba(255,255,255,.08);
      color: #fff;
      text-decoration: none;
      font-size: 23px;
    }

    .brand {
      font-weight: 900;
      font-size: 16px;
    }

    .subtitle {
      color: #91a7a7;
      font-size: 11px;
      margin-top: 3px;
    }

    main {
      max-width: 700px;
      margin: auto;
      padding: 24px 16px;
    }

    .hero {
      margin-bottom: 22px;
    }

    .hero h1 {
      font-size: 30px;
      margin-bottom: 8px;
    }

    .hero p {
      color: #9aafaf;
      font-size: 14px;
      line-height: 1.6;
    }

    .service-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .service {
      position: relative;
      min-height: 165px;
      padding: 18px;
      border-radius: 20px;
      background:
        linear-gradient(
          145deg,
          rgba(255,255,255,.08),
          rgba(255,255,255,.025)
        );
      border: 1px solid rgba(255,255,255,.08);
      box-shadow: 0 15px 35px rgba(0,0,0,.18);
      overflow: hidden;
    }

    .service::after {
      content: "";
      position: absolute;
      width: 80px;
      height: 80px;
      right: -30px;
      bottom: -30px;
      background: rgba(37,211,102,.12);
      border-radius: 50%;
    }

    .icon {
      width: 48px;
      height: 48px;
      display: grid;
      place-items: center;
      border-radius: 15px;
      background: rgba(37,211,102,.13);
      border: 1px solid rgba(37,211,102,.2);
      font-size: 25px;
      margin-bottom: 14px;
    }

    .service h3 {
      font-size: 16px;
      margin-bottom: 7px;
    }

    .service p {
      color: #8fa5a5;
      font-size: 12px;
      line-height: 1.45;
    }

    .status {
      display: inline-block;
      margin-top: 12px;
      padding: 5px 8px;
      border-radius: 8px;
      background: rgba(255,190,60,.1);
      color: #ffc44d;
      font-size: 10px;
      font-weight: 700;
    }

    .available {
      background: rgba(37,211,102,.1);
      color: #25d366;
    }

    .support {
      margin-top: 18px;
      padding: 19px;
      border-radius: 20px;
      background: linear-gradient(
        135deg,
        rgba(37,211,102,.12),
        rgba(255,255,255,.04)
      );
      border: 1px solid rgba(37,211,102,.18);
    }

    .support h2 {
      font-size: 18px;
      margin-bottom: 7px;
    }

    .support p {
      color: #9aafaf;
      font-size: 13px;
      line-height: 1.5;
      margin-bottom: 14px;
    }

    .whatsapp {
      display: inline-block;
      text-decoration: none;
      padding: 13px 17px;
      border-radius: 12px;
      background: #25d366;
      color: #001b0b;
      font-weight: 900;
      font-size: 13px;
    }

    .bottom-nav {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      height: 68px;
      background: rgba(3,10,10,.97);
      border-top: 1px solid rgba(255,255,255,.08);
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      z-index: 30;
    }

    .bottom-nav a {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      color: #829696;
      text-decoration: none;
      font-size: 11px;
    }

    .bottom-nav a.active {
      color: #25d366;
      font-weight: 700;
    }

    .bottom-icon {
      font-size: 20px;
    }

    @media (max-width: 380px) {
      .service-grid {
        gap: 9px;
      }

      .service {
        padding: 14px;
        min-height: 155px;
      }

      .service h3 {
        font-size: 14px;
      }
    }

    @media (min-width: 650px) {
      .service-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }
  </style>
</head>

