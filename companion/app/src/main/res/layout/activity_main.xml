<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/dgm_dark">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DGM" android:textColor="@color/dgm_green" android:textSize="32sp" android:textStyle="bold" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DGM Companion" android:textColor="@color/dgm_text" android:textSize="24sp" android:textStyle="bold" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Stay Connected. Stay Genius." android:textColor="@color/dgm_muted" android:textSize="14sp" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Connect this phone to your DGM account. Your credentials are used only to create a secure device token." android:textColor="@color/dgm_text" android:textSize="15sp" />
<EditText android:id="@+id/emailInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:hint="DGM account email" android:inputType="textEmailAddress" android:textColor="@color/dgm_text" android:textColorHint="@color/dgm_muted" />
<EditText android:id="@+id/passwordInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="DGM account password" android:inputType="textPassword" android:textColor="@color/dgm_text" android:textColorHint="@color/dgm_muted" />
<EditText android:id="@+id/deviceInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Device name (e.g. My Android)" android:inputType="textCapWords" android:textColor="@color/dgm_text" android:textColorHint="@color/dgm_muted" />
<Button android:id="@+id/connectButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Connect to DGM" />
<TextView android:id="@+id/deviceStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@color/dgm_card" android:padding="18dp" android:text="DGM connection: Not connected" android:textColor="@color/dgm_text" android:textSize="16sp" />
<TextView android:id="@+id/smsStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@color/dgm_card" android:padding="18dp" android:text="SMS access: Checking…" android:textColor="@color/dgm_text" android:textSize="16sp" />
<Button android:id="@+id/smsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Grant SMS Access" />
<TextView android:id="@+id/whatsappStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@color/dgm_card" android:padding="18dp" android:text="WhatsApp notification access: Not enabled" android:textColor="@color/dgm_text" android:textSize="16sp" />
<Button android:id="@+id/whatsappButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Enable Notification Access" />
<Button android:id="@+id/settingsButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Open Android Settings" />
</LinearLayout></ScrollView>