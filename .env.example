NODE_ENV=production
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
ADMIN_EMAIL=admin@dhegeniusmedia.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_ADMIN_PASSWORD\nYOUTUBE_API_KEY=REPLACE_WITH_YOUTUBE_DATA_API_KEY\nYOUTUBE_CHANNEL_ID=REPLACE_WITH_YOUTUBE_CHANNEL_ID\n\n# Audiomack API (add only after Audiomack grants access; keep secrets server-side)
AUDIOMACK_CONSUMER_KEY=REPLACE_WITH_APPROVED_CONSUMER_KEY
AUDIOMACK_CONSUMER_SECRET=REPLACE_WITH_APPROVED_CONSUMER_SECRET
# Override endpoint paths if Audiomack's approval documentation specifies different routes
AUDIOMACK_SEARCH_PATH=/search
AUDIOMACK_TRENDING_PATH=/music/trending
AUDIOMACK_RECENT_PATH=/music/recent
